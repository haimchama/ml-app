{
  // Worker "ml-app": serves the office system (static files in public/) and its API (/api/*)
  // at https://ml.tkb-pro.com only.
  "name": "ml-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ml.tkb-pro.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ml",
      // Set by the owner after creating the D1 database "ml".
      "database_id": "153f0f3e-28d6-488a-8f86-c9b7aedb3aaf"
    }
  ],
  // Login codes (2FA) go out through Cloudflare Email Service.
  // The sending domain must be onboarded once by the owner (see README).
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "MAIL_FROM": "no-reply@ml.tkb-pro.com" },
  "observability": { "enabled": true }
  // Secrets (set in Cloudflare, never in this file): SETUP_TOKEN
}
